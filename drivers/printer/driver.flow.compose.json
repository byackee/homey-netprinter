    {
      "id": "pages_printed",
      "title": {
        "en": "Pages have been printed",
        "fr": "Des pages ont été imprimées",
        "nl": "Er zijn pagina's afgedrukt"
      },
      "tokens": [
        {
          "name": "pages",
          "type": "number",
          "title": {
            "en": "Pages since last check",
            "fr": "Pages depuis le dernier relevé",
            "nl": "Pagina's sinds laatste meting"
          },
          "example": {
            "en": "3"
          }
        },
        {
          "name": "total",
          "type": "number",
          "title": {
            "en": "Lifetime total",
            "fr": "Total depuis l’origine",
            "nl": "Totaal sinds ingebruikname"
          },
          "example": {
            "en": "1116"
          }
        }
      ]
    },
    {
      "id": "printer_error",
      "title": {
        "en": "The printer reports an error",
        "fr": "L’imprimante signale une erreur",
        "nl": "De printer meldt een fout"
      },
      "hint": {
        "en": "Covers errors that stop printing: paper jam, out of paper, open cover, missing cartridge. Low-supply warnings have their own card.",
        "fr": "Couvre les erreurs qui bloquent l’impression : bourrage, plus de papier, capot ouvert, cartouche absente. Les alertes de niveau bas ont leur propre carte.",
        "nl": "Dekt fouten die het afdrukken stoppen: papierstoring, papier op, klep open, ontbrekende cartridge. Waarschuwingen over lage niveaus hebben hun eigen kaart."
      },
      "tokens": [
        {
          "name": "errors",
          "type": "string",
          "title": {
            "en": "Errors",
            "fr": "Erreurs",
            "nl": "Fouten"
          },
          "example": {
            "en": "jammed, doorOpen"
          }
        }
      ]
    },
    {
      "id": "alarm_cover_open_true",
      "title": {
        "en": "A cover is opened",
        "fr": "Un capot s’ouvre",
        "nl": "Een klep gaat open"
      },
      "hint": {
        "en": "Only fires on printers that report a cover sensor over SNMP.",
        "fr": "Ne se déclenche que sur les imprimantes qui signalent un capteur de capot en SNMP.",
        "nl": "Werkt alleen op printers die een klepsensor via SNMP melden."
      }
    },
    {
      "id": "alarm_cover_open_false",
      "title": {
        "en": "Every cover is closed",
        "fr": "Tous les capots sont fermés",
        "nl": "Alle kleppen zijn dicht"
      }
    },
    {
      "id": "alarm_paper_low_true",
      "title": {
        "en": "Paper runs low",
        "fr": "Le papier vient à manquer",
        "nl": "Het papier raakt op"
      },
      "hint": {
        "en": "Uses the same threshold as the supply alarm. Manual feed slots are ignored, since an empty one is their resting state.",
        "fr": "Utilise le même seuil que l’alarme de consommable. Les bacs d’alimentation manuelle sont ignorés : vides, ils sont au repos.",
        "nl": "Gebruikt dezelfde drempel als het verbruiksalarm. Handinvoerladen tellen niet mee; leeg is hun ruststand."
      }
    },
    {
      "id": "alarm_paper_low_false",
      "title": {
        "en": "Paper is topped up",
        "fr": "Le papier est réapprovisionné",
        "nl": "Het papier is bijgevuld"
      }
    }
  ],
  "conditions": [
    {
      "id": "supply_below",
      "title": {
        "en": "A supply is !{{below|not below}} a level",
        "fr": "Un consommable est !{{en dessous|au-dessus}} d’un niveau",
        "nl": "Een verbruiksartikel is !{{onder|niet onder}} een niveau"
      },
      "titleFormatted": {
        "en": "[[capability]] is !{{below|not below}} [[level]] %",
        "fr": "[[capability]] est !{{en dessous de|au-dessus de}} [[level]] %",
        "nl": "[[capability]] is !{{onder|niet onder}} [[level]] %"
      },
      "args": [
        {
          "name": "capability",
          "type": "autocomplete",
          "title": {
            "en": "Supply",
            "fr": "Consommable",
            "nl": "Verbruiksartikel"
          }
        },
        {
          "name": "level",
          "type": "number",
          "title": {
            "en": "Level",
            "fr": "Niveau",
            "nl": "Niveau"
          },
          "min": 0,
          "max": 100,
          "step": 1
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "refresh_printer",
      "title": {
        "en": "Read the printer now",
        "fr": "Relever l’imprimante maintenant",
        "nl": "De printer nu uitlezen"
      },
      "hint": {
        "en": "Polls immediately instead of waiting for the next scheduled check. Useful right after a print job.",
        "fr": "Interroge l’imprimante immédiatement au lieu d’attendre le prochain relevé. Utile juste après une impression.",
        "nl": "Leest direct uit in plaats van te wachten op de volgende meting. Handig vlak na een afdruktaak."
      }
    }
  ]
}
