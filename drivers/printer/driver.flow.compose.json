{
  "triggers": [
    {
      "id": "supply_low",
      "title": {
        "en": "A supply runs low",
        "fr": "Un consommable devient bas",
        "nl": "Een verbruiksartikel raakt op"
      },
      "hint": {
        "en": "Fires once when a cartridge or tank crosses the threshold set in the device settings, not on every check.",
        "fr": "Se déclenche une fois quand une cartouche ou un réservoir passe sous le seuil défini dans les réglages de l’appareil, pas à chaque relevé.",
        "nl": "Wordt eenmalig geactiveerd wanneer een cartridge of tank onder de drempel uit de apparaatinstellingen zakt, niet bij elke meting."
      },
      "tokens": [
        {
          "name": "supply",
          "type": "string",
          "title": {
            "en": "Supply",
            "fr": "Consommable",
            "nl": "Verbruiksartikel"
          },
          "example": {
            "en": "Black Ink Cartridge 202/202XL"
          }
        },
        {
          "name": "level",
          "type": "number",
          "title": {
            "en": "Level",
            "fr": "Niveau",
            "nl": "Niveau"
          },
          "example": {
            "en": "12"
          }
        }
      ]
    },
