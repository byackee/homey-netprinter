{
  "name": {
    "en": "Printer",
    "fr": "Imprimante",
    "nl": "Printer"
  },
  "class": "sensor",
  "capabilities": [
    "onoff",
    "printer_status",
    "alarm_supply_low",
    "alarm_problem"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/printer/assets/images/small.png",
    "large": "/drivers/printer/assets/images/large.png",
    "xlarge": "/drivers/printer/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "start"
    }
  ],
  "repair": [
    {
      "id": "configure"
    }
  ],
  "discovery": "printer",
  "capabilitiesOptions": {
    "onoff": {
      "setable": false,
      "title": {
        "en": "Responding",
        "fr": "Répond",
        "nl": "Reageert"
      },
      "insightsTitleTrue": {
        "en": "The printer answered",
        "fr": "L’imprimante a répondu",
        "nl": "De printer antwoordde"
      },
      "insightsTitleFalse": {
        "en": "The printer stopped answering",
        "fr": "L’imprimante ne répond plus",
        "nl": "De printer antwoordt niet meer"
      }
    },
    "alarm_problem": {
      "title": {
        "en": "Printer error",
        "fr": "Erreur d’imprimante",
        "nl": "Printerfout"
      },
      "insightsTitleTrue": {
        "en": "The printer stopped being able to print",
        "fr": "L’imprimante ne peut plus imprimer",
        "nl": "De printer kan niet meer afdrukken"
      },
      "insightsTitleFalse": {
        "en": "The printer can print again",
        "fr": "L’imprimante peut de nouveau imprimer",
        "nl": "De printer kan weer afdrukken"
      }
    },
    "alarm_open": {
      "title": {
        "en": "Cover open",
        "fr": "Capot ouvert",
        "nl": "Klep open"
      },
      "insightsTitleTrue": {
        "en": "A cover was opened",
        "fr": "Un capot a été ouvert",
        "nl": "Een klep ging open"
      },
      "insightsTitleFalse": {
        "en": "Every cover is closed",
        "fr": "Tous les capots sont fermés",
        "nl": "Alle kleppen zijn dicht"
      }
    }
  }
}
